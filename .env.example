# Copy this file to .env.local and paste your key.
#
#   cp .env.example .env.local
#
# Get a free key at https://aistudio.google.com/apikey (click "Create API key").
# The AI "Suggest tailored edits" button works without a key too — it returns
# canned demo suggestions so the feature is always demoable. Add the key for
# live Gemini results.
#
# Note: this is a NEXT_PUBLIC_ var, so it is bundled into the browser. That is
# fine for a local demo; do not ship a real key to a public deployment.

NEXT_PUBLIC_GEMINI_API_KEY=

# Base URL of the FastAPI backend (backend/ in this repo, originally from
# the careersavers reference project), used by the "Auto Search" option on
# the Applications page's + Add button. Run it locally with
# `uvicorn app.main:app --reload` from the backend/ folder.
NEXT_PUBLIC_CAREERSAVERS_API_URL=http://localhost:8000
